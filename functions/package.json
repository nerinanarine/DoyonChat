{
  "name": "doyonchat-functions",
  "version": "1.0.0",
  "private": true,
  "description": "DoyonChat Azure Functions backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "start": "npm run build && func start",
    "start:func": "func start",
    "test": "jest --coverage",
    "test:unit": "jest --testMatch='**/tests/unit/**/*.test.ts' --coverage",
    "test:integration": "jest --testMatch='**/tests/integration/**/*.test.ts' --coverage"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.3",
    "@azure/functions": "^4.16.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.42",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
